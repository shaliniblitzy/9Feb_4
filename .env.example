# =============================================================================
# Reverse Document Generator — Flask Server
# Environment Variable Configuration Template
# =============================================================================
#
# Copy this file to .env and fill in real values for your environment.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control. All API keys,
# passwords, and service URLs must remain in environment variables only.
#
# Variables are grouped by service integration. Required variables are marked
# with [REQUIRED]; optional variables include sensible defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask Application Configuration
# -----------------------------------------------------------------------------
# Flask entry-point module (used by `flask run` and Gunicorn)
FLASK_APP=app.main:application

# Environment selector — controls which Config class is loaded.
# Accepted values: development | staging | production
FLASK_ENV=development

# Secret key for Flask session signing and CSRF protection.
# [REQUIRED] Generate a strong random value for staging/production.
FLASK_SECRET_KEY=change-me-in-production


# -----------------------------------------------------------------------------
# Google Cloud Platform — Project & Infrastructure
# -----------------------------------------------------------------------------
# GCP project ID for all Cloud API calls (Storage, Pub/Sub, etc.)
PROJECT_ID=blitzy-os-dev

# GCS bucket used for document storage (prompts, tech specs, outputs)
GCS_BUCKET_NAME=blitzy-os-internal

# GCS blob prefix for private source artifacts
PRIVATE_BLOB_NAME=private-src

# Pub/Sub topic for progress and completion event notifications
PLATFORM_EVENTS_TOPIC=platform-events

# Pub/Sub topic for reverse-thinking generation events (optional)
GENERATE_REVERSE_THINKING_TOPIC=generate-reverse-thinking


# -----------------------------------------------------------------------------
# AI / LLM Service API Keys
# -----------------------------------------------------------------------------
# Anthropic API key for Claude Opus 4.6 (primary LLM — context gathering,
# authoring, diagram generation). [REQUIRED]
ANTHROPIC_API_KEY=sk-ant-replace-with-real-key

# OpenAI API key for GPT-5 Mini (structured classification in UPDATE mode).
# [REQUIRED]
OPENAI_API_KEY=sk-proj-replace-with-real-key

# Voyage AI API key for embedding generation (Neo4j semantic search).
# [REQUIRED]
VOYAGE_API_KEY=pa-replace-with-real-key

# Google API key for Gemini (alternative Architect LLM, optional fallback).
GOOGLE_API_KEY=AIza-replace-with-real-key


# -----------------------------------------------------------------------------
# Neo4j — Code Graph Database
# -----------------------------------------------------------------------------
# Bolt connection URI for the Neo4j instance used by CodeGraphBuilder
NEO4J_SERVER=neo4j://localhost:7687

# Neo4j authentication credentials. [REQUIRED]
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password


# -----------------------------------------------------------------------------
# GitHub — Repository Access
# -----------------------------------------------------------------------------
# URL of the Archie Secret Manager service that provides GitHub credentials
# for repository download. [REQUIRED]
GITHUB_SECRET_SERVER=https://archie-secret-manager-replace-with-real-url


# -----------------------------------------------------------------------------
# Admin Service — Platform API
# -----------------------------------------------------------------------------
# Base URL for the Admin Service REST API (attachments, build info,
# environment files, Figma metadata). [REQUIRED]
SERVICE_URL_ADMIN=https://admin-service-replace-with-real-url


# -----------------------------------------------------------------------------
# LangSmith — LLM Tracing & Observability
# -----------------------------------------------------------------------------
# Enable or disable LangSmith tracing (set to "true" to enable)
LANGSMITH_TRACING=true

# LangSmith API endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API key for trace submission. [REQUIRED when tracing is enabled]
LANGSMITH_API_KEY=ls-replace-with-real-key

# LangSmith project name for grouping traces
LANGSMITH_PROJECT=reverse-document-generator


# -----------------------------------------------------------------------------
# Application Runtime Settings
# -----------------------------------------------------------------------------
# Disable tokenizer parallelism to avoid deadlocks in forked processes
# (required when running under Gunicorn with preload_app=True)
TOKENIZERS_PARALLELISM=false
